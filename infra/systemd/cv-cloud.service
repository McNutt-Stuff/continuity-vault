[Unit]
Description=Arkive Cloud Control Plane
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cvault
Group=cvault
EnvironmentFile=/etc/continuity-vault.env
WorkingDirectory=/opt/continuity-vault/cloud
ExecStart=/opt/continuity-vault/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/continuity-vault
PrivateTmp=true

[Install]
WantedBy=multi-user.target
