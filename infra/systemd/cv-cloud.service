[Unit]
Description=Arkive Cloud Control Plane
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cvault
Group=cvault
EnvironmentFile=/etc/continuity-vault.env
# Load the system liboqs (built to /usr/local) so the process never tries to
# auto-build post-quantum libs at runtime under the sandbox.
Environment=OQS_INSTALL_PATH=/usr/local
# Writable object store (WorkingDirectory is read-only under ProtectSystem=strict).
Environment=CV_OBJECT_STORE=/var/lib/continuity-vault/object_store
WorkingDirectory=/opt/continuity-vault/cloud
# Single worker: the all-in-one node initializes the schema and seeds on
# startup, which must not race across workers. Scale out behind a shared,
# already-migrated database instead.
ExecStart=/opt/continuity-vault/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/continuity-vault
PrivateTmp=true

[Install]
WantedBy=multi-user.target
