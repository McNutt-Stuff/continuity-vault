[Unit]
Description=Arkive Appliance Agent
After=network.target

[Service]
Type=simple
User=cvagent
Group=cvagent
EnvironmentFile=/etc/continuity-vault/appliance.env
# Load the system liboqs (built to /usr/local) so the process never tries to
# auto-build post-quantum libs at runtime under the sandbox.
Environment=OQS_INSTALL_PATH=/usr/local
WorkingDirectory=/opt/continuity-vault/appliance
# Bind on all interfaces so the on-appliance web UI (local status + pairing code)
# is reachable from the LAN. The management plane remains outbound-only.
ExecStart=/opt/continuity-vault/.venv/bin/uvicorn agent.main:app --host 0.0.0.0 --port 8090
# Reload = re-read external-storage registry + mount new drives in place (cvtool
# signals this after setting up a USB/external drive, avoiding a full restart).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The system disk data dir plus the optional dedicated Arkive storage volume
# (a separate RAID disk mounted at /arkive). The '-' prefix makes /arkive
# optional so the unit still starts on appliances without a dedicated volume.
ReadWritePaths=/var/lib/continuity-vault-appliance -/arkive
PrivateTmp=true

[Install]
WantedBy=multi-user.target
