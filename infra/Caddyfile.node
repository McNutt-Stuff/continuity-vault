# Arkive customer-tenant (data-plane) node.
# Exposes ONLY the API for control-plane <-> node communication. No customer
# portal is served here — customers always use the UI on the control plane; this
# node just runs the tenant's workers, indexing, sync, and storage channels.

{{DOMAIN}} {
	encode zstd gzip

	# API -> local control-plane application (workers/indexing/sync live here).
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			lb_try_duration 5s
		}
	}

	# No public web interface on a data-plane node.
	handle {
		respond "Arkive data-plane node — no public interface" 404
	}

	# During a node redeploy, surface a retryable 503 (not a bare 502) so the
	# control plane / agents treat it as "updating, retry shortly".
	handle_errors {
		@cp_down expression {http.error.status_code} in [502, 503, 504]
		handle @cp_down {
			header Retry-After "30"
			header Content-Type "application/json"
			respond `{"error":"node_updating","detail":"Node is updating — retry shortly."}` 503
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
