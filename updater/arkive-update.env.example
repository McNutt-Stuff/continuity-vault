# Arkive updater configuration.
# Copy to /etc/arkive-update.env on the cloud server and/or each appliance.
#
#   sudo cp updater/arkive-update.env.example /etc/arkive-update.env
#   sudo nano /etc/arkive-update.env
#
# Then run an update manually:
#   sudo /opt/arkive-src/updater/git-update.sh cloud
# or enable the timer for automatic updates:
#   sudo systemctl enable --now cv-cloud-update.timer

# GitHub repository to update from.
CV_REPO_URL=https://github.com/McNutt-Stuff/continuity-vault.git

# Branch to track (leave unset to auto-detect the repo's default branch).
CV_REPO_BRANCH=main

# For private repositories, use a token URL, e.g.:
# CV_REPO_URL=https://<username>:<token>@github.com/McNutt-Stuff/continuity-vault.git

# Cloud only: the domain (usually already in /etc/continuity-vault.env).
# CV_DOMAIN=vault.arkive.life

# Appliance only: the cloud API base URL.
# CV_CLOUD_URL=https://vault.arkive.life/api
